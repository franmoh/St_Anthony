DB_NAME=cemetery
DB_USER=cemetery_user
DB_PASSWORD=your_password_here
DB_HOST=127.0.0.1
DB_PORT=3306
SECRET_KEY=your_secret_key_here

# --- Production (Render) --- leave unset for local development
# DEBUG=false
# ALLOWED_HOSTS=example.com            # Render's own hostname is added automatically
# CSRF_TRUSTED_ORIGINS=https://example.com
# Hosted MySQL over TLS (Aiven): give the CA certificate as a path or as its text
# DB_SSL_CA=/path/to/ca.pem
# DB_SSL_CA_PEM=-----BEGIN CERTIFICATE-----...
