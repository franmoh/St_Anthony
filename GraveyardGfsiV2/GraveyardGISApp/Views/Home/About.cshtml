@{
    ViewData["Title"] = "About";
}

<div class="row align-items-center justify-content-center py-5 g-5">
    <div class="col-lg-8 text-center">
        <h1 class="display-4 fw-bold">About This Project</h1>
        <p class="lead text-muted mt-3">
            A digital graveyard locator for St. Anthony's Cemetery, preserving history,
            empowering staff, and serving the community.
        </p>
        <hr class="my-4 w-50 mx-auto" />
    </div>
</div>

<section class="mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <h2 class="fw-bold mb-4">Background</h2>
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">Custodians of History</h5>
                            <p class="card-text text-muted">
                                Cemeteries are custodians of local history, heritage, and community memory.
                                They hold irreplaceable records that connect families to their past and
                                researchers to important historical data.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">A Need for Modernization</h5>
                            <p class="card-text text-muted">
                                Many cemeteries still operate with outdated, manual record-keeping systems.
                                This project aims to change that by bringing modern technology to
                                St. Anthony's Cemetery.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5 mb-5 rounded bg-primary">
    <div class="row justify-content-center">
        <div class="col-lg-10 text-white px-4">
            <h2 class="fw-bold mb-4">Project Goal</h2>
            <div class="row g-4">
                <div class="col-md-6">
                    <ul class="list-unstyled">
                        <li class="mb-3 d-flex align-items-start">
                            <span class="me-2 fs-5">&#10003;</span>
                            <span>Create a digital graveyard locator for St. Anthony's Cemetery.</span>
                        </li>
                        <li class="mb-3 d-flex align-items-start">
                            <span class="me-2 fs-5">&#10003;</span>
                            <span>Allow staff to easily locate specific burial plots, view grave information, and navigate the cemetery grounds efficiently.</span>
                        </li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <ul class="list-unstyled">
                        <li class="mb-3 d-flex align-items-start">
                            <span class="me-2 fs-5">&#10003;</span>
                            <span>Provide access to synced data on graveyard information, schedules, payments, and special arrangements such as spiritual burials.</span>
                        </li>
                        <li class="mb-3 d-flex align-items-start">
                            <span class="me-2 fs-5">&#10003;</span>
                            <span>Enhance the experience for families, researchers, and the wider community.</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <h2 class="fw-bold mb-4">The Core Problem</h2>
            <div class="row g-4">
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 border-0 shadow-sm text-center">
                        <div class="card-body">
                            <div class="display-6 text-primary mb-3">&#128221;</div>
                            <h6 class="fw-bold">Manual Systems</h6>
                            <p class="card-text text-muted small">
                                Paper-based ledgers and maps are prone to damage and loss, making it
                                difficult to locate and retrieve information.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 border-0 shadow-sm text-center">
                        <div class="card-body">
                            <div class="display-6 text-primary mb-3">&#9888;</div>
                            <h6 class="fw-bold">Data Vulnerability</h6>
                            <p class="card-text text-muted small">
                                Physical records risk deterioration or disaster, and information remains
                                disconnected and inaccessible for end-users.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 border-0 shadow-sm text-center">
                        <div class="card-body">
                            <div class="display-6 text-primary mb-3">&#128176;</div>
                            <h6 class="fw-bold">Limited Resources</h6>
                            <p class="card-text text-muted small">
                                Small budgets and reliance on volunteers make adopting commercial
                                solutions challenging.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 border-0 shadow-sm text-center">
                        <div class="card-body">
                            <div class="display-6 text-primary mb-3">&#127758;</div>
                            <h6 class="fw-bold">Lack of Local Solutions</h6>
                            <p class="card-text text-muted small">
                                Existing solutions are mostly US-based, leaving Canadian cemeteries
                                without tailored options. Volunteer retention is also a crisis.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <h2 class="fw-bold mb-4">Key Features</h2>
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="card h-100 border-start border-4 border-primary shadow-sm">
                        <div class="card-body">
                            <h5 class="fw-bold mb-3">Search Functionality</h5>
                            <p class="text-muted">A user-friendly search interface that allows queries based on:</p>
                            <ul class="text-muted">
                                <li>Full name (first and last name)</li>
                                <li>Date of birth or death</li>
                                <li>Section or plot number</li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card h-100 border-start border-4 border-primary shadow-sm">
                        <div class="card-body">
                            <h5 class="fw-bold mb-3">Interactive Map</h5>
                            <p class="text-muted">A digital map of St. Anthony's Cemetery featuring:</p>
                            <ul class="text-muted">
                                <li>Clickable sections and grave markers</li>
                                <li>Visual display of searched grave locations</li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card h-100 border-start border-4 border-primary shadow-sm">
                        <div class="card-body">
                            <h5 class="fw-bold mb-3">Grave-Specific Information</h5>
                            <p class="text-muted">A dedicated page for each burial plot containing:</p>
                            <ul class="text-muted">
                                <li>Full name of the deceased</li>
                                <li>Dates of birth and death</li>
                                <li>Photos of the headstone and grave</li>
                                <li>Biographical notes or family history</li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card h-100 border-start border-4 border-primary shadow-sm">
                        <div class="card-body">
                            <h5 class="fw-bold mb-3">Admin Dashboard</h5>
                            <p class="text-muted">A secure, password-protected backend for cemetery staff to:</p>
                            <ul class="text-muted">
                                <li>Add, edit, and delete grave records</li>
                                <li>Update location data</li>
                                <li>Upload and manage documents and photos</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="text-center py-5 mb-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <p class="text-muted">
                Built for <strong>St. Anthony's Church</strong> by <strong>Civic Tech Fredericton</strong> volunteers.
            </p>
            <a asp-area="" asp-controller="Home" asp-action="Contact" class="btn btn-primary btn-lg mt-2">Get in Touch</a>
        </div>
    </div>
</section>
