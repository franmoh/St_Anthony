@{
    ViewData["Title"] = "Contact";
}

<div class="row align-items-center justify-content-center py-5 g-5">
    <div class="col-lg-8 text-center">
        <h1 class="display-4 fw-bold">Contact Us</h1>
        <p class="lead text-muted mt-3">
            We'd love to hear from you. Reach out to Our Lady of Peace Parish using any of the methods below.
        </p>
        <hr class="my-4 w-50 mx-auto" />
    </div>
</div>

<section class="mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="row g-4">

                <div class="col-md-6">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body">
                            <h5 class="fw-bold mb-3">Address</h5>
                            <p class="text-muted mb-1">Our Lady of Peace Parish</p>
                            <p class="text-muted mb-1">603 Union St</p>
                            <p class="text-muted mb-0">Fredericton, NB E3A 3N5</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body">
                            <h5 class="fw-bold mb-3">Get in Touch</h5>
                            <p class="text-muted mb-1">
                                <span class="fw-semibold">Telephone:</span>
                                <a href="tel:5064446010" class="text-decoration-none">(506) 444-6010</a>
                            </p>
                            <p class="text-muted mb-1">
                                <span class="fw-semibold">Fax:</span> (506) 444-6060
                            </p>
                            <p class="text-muted mb-0">
                                <span class="fw-semibold">Email:</span>
                                <a href="mailto:parishoffice@ourladyofpeacefredericton.ca" class="text-decoration-none">parishoffice&#64;ourladyofpeacefredericton.ca</a>
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body">
                            <h5 class="fw-bold mb-3">Office Hours</h5>
                            <p class="text-muted mb-1 fw-semibold">Monday &ndash; Friday</p>
                            <p class="text-muted mb-0">9:30 AM &ndash; 4:30 PM</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body">
                            <h5 class="fw-bold mb-3">Connect With Us</h5>
                            <p class="text-muted mb-3">Follow us on Facebook for parish news and updates.</p>
                            <a href="http://www.facebook.com/Ourladyofpeaceparishfredericton"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="btn btn-primary">
                                Visit Our Facebook Page
                            </a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

<section class="mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <h2 class="fw-bold mb-4">Three Churches - One Parish Community</h2>
            <div class="row g-4">

                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="ratio ratio-4x3">
                            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2773.0!2d-66.6469!3d45.9636!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4ca418a6c0b7b8ed%3A0x1e871e4f72a13c5e!2s603%20Union%20St%2C%20Fredericton%2C%20NB!5e0!3m2!1sen!2sca!4v1700000000000"
                                    class="rounded-top"
                                    allowfullscreen=""
                                    loading="lazy"
                                    referrerpolicy="no-referrer-when-downgrade">
                            </iframe>
                        </div>
                        <div class="card-body text-center">
                            <h5 class="fw-bold mb-1">St. Anthony's Church</h5>
                            <p class="text-muted mb-0">603 Union St, Fredericton, NB</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="ratio ratio-4x3">
                            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2773.0!2d-66.5553!3d46.8715!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4ca3f1a0c0b7b8ed%3A0x1e871e4f72a13c5e!2s31%20Main%20St%2C%20Stanley%2C%20NB!5e0!3m2!1sen!2sca!4v1700000000000"
                                    class="rounded-top"
                                    allowfullscreen=""
                                    loading="lazy"
                                    referrerpolicy="no-referrer-when-downgrade">
                            </iframe>
                        </div>
                        <div class="card-body text-center">
                            <h5 class="fw-bold mb-1">St. Patrick's Church</h5>
                            <p class="text-muted mb-0">31 Main St, Stanley, NB</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="ratio ratio-4x3">
                            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2773.0!2d-66.6361!3d45.9569!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4ca418b6c0b7b8ed%3A0x1e871e4f72a13c5e!2s1%20William%20St%2C%20Fredericton%2C%20NB!5e0!3m2!1sen!2sca!4v1700000000000"
                                    class="rounded-top"
                                    allowfullscreen=""
                                    loading="lazy"
                                    referrerpolicy="no-referrer-when-downgrade">
                            </iframe>
                        </div>
                        <div class="card-body text-center">
                            <h5 class="fw-bold mb-1">St. Theresa's Church</h5>
                            <p class="text-muted mb-0">1 William St, Fredericton, NB</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>
